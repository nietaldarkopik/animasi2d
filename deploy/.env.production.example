# ===== Cartoon Maker AI — production environment (docker compose) =====
# Copy to deploy/.env and fill in every value marked CHANGE. Never commit the real file.

APP_NAME="Cartoon Maker AI"
APP_ENV=production
APP_DEBUG=false
# Generate:  docker compose -f deploy/docker-compose.yml run --rm --no-deps -e APP_KEY=x app php artisan key:generate --show
APP_KEY=CHANGE
# Public URL users type in the browser (https strongly recommended)
APP_URL=https://studio.example.com
# Trust the reverse proxy in front of nginx for X-Forwarded-* (needed for correct signed asset URLs). "*" is fine when only the proxy can reach the stack.
TRUSTED_PROXIES=*
WEB_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cartoon_maker
DB_USERNAME=cartoon
DB_PASSWORD=CHANGE

# --- queue + cache (Redis, predis client: no PHP extension needed) ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE

# --- files: local disk on the shared volume (S3 is NOT supported yet: FFmpeg/Pillow need local paths) ---
FILESYSTEM_DISK=local

# --- auth ---
SANCTUM_EXPIRATION=43200          # minutes a login token stays valid (30 days)
CORS_ALLOWED_ORIGINS=https://studio.example.com

# --- AI via 9router (OpenAI-compatible gateway). Leave AI_API_KEY empty to disable AI features. ---
# 9router running on the Docker host:  http://host.docker.internal:20128/v1  (it must listen on an address the container can reach)
AI_BASE_URL=http://host.docker.internal:20128/v1
AI_API_KEY=
AI_MODEL=Kombo
AI_TIMEOUT=120
# set false to refuse new sign-ups on a private instance
REGISTRATION_ENABLED=true
